{
  "name": "ky-knife4j",
  "description": "根据 Knife4j 文档生成前端接口 JS 代码",
  "version": "1.1.0",
  "manifest_version": 3,
  "icons": {
    "48": "icon_48.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "js/lib/jquery.min.js",
        "js/content.js"
      ],
      "css": ["css/content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["<all_urls>"],
  "permissions": [
    "storage",
    "tabs",
    "clipboardWrite"
  ],
  "action": {
    "default_icon": {
      "48": "icon_48.png"
    },
    "default_popup": "popup.html"
  }
}
